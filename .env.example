# Anthropic API Key — get yours at https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# Google OAuth 2.0 Client ID
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "Google Calendar API"
# 3. Go to APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 4. Type: Web Application
# 5. Add Authorized JavaScript Origins: http://localhost:5173
# 6. Copy the Client ID here
VITE_GOOGLE_CLIENT_ID=123456789-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Optional: override the model (default: claude-sonnet-4-20250514)
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
